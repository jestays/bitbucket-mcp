# Atlassian account email (the account that will author review comments).
BITBUCKET_EMAIL=

# Atlassian API token. Create it at:
# https://id.atlassian.com/manage-profile/security/api-tokens
# (App Passwords are deprecated — use API tokens.)
BITBUCKET_API_TOKEN=

# Optional. Default workspace so tools don't need it on every call.
BITBUCKET_WORKSPACE=
