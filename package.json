{
  "name": "@jestay/bitbucket-mcp",
  "version": "0.1.2",
  "description": "MCP server for code review of Bitbucket Cloud pull requests",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bitbucket-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx --env-file=.env src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "prepublishOnly": "pnpm build",
    "release": "npm version patch && git push --follow-tags && npm publish"
  },
  "keywords": [
    "mcp",
    "bitbucket",
    "code-review",
    "pull-request"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jestays/bitbucket-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/jestays/bitbucket-mcp/issues"
  },
  "homepage": "https://github.com/jestays/bitbucket-mcp#readme"
}
